# Copy to .env locally, edit, then: set -a; source .env; set +a
# Never commit .env. GitHub Actions uses repository Secrets / Variables instead.
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPOSITORY=okamoto-suzukilab/code-review-pr
# For a personal token, use YOUR GitHub login. Actions uses github-actions[bot].
COMMENT_AUTHOR=okamoto-suzukilab
GITHUB_API_URL=https://api.github.com

LLM_PROVIDER=openai
# Example only: choose an accessible model supporting JSON Schema structured output.
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# To use Ollama, change LLM_PROVIDER=ollama and LLM_MODEL to a pulled model name.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_SIZE=32768
HTTP_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=2000
MAX_DIFF_CHARS=24000
MAX_FILES=40
# Additional comma-separated fnmatch patterns; default exclusions stay enabled.
EXCLUDE_GLOBS='private/*,secrets/*'
